
flowchart TD
    A["Authenticated admin"] --> B["Submit current and new password"]
    B --> C["AuthController"]
    C --> D["AuthServiceImpl"]
    D --> E["Verify current password with BCrypt"]
    E --> F{"Current password valid?"}
    F -->|No| X["Reject request"]
    F -->|Yes| G["Validate confirmation and password length"]
    G --> H{"New password valid?"}
    H -->|No| X
    H -->|Yes| I["Hash new password using BCrypt"]
    I --> J["Update password_hash"]
    J --> K["Increment tokenVersion"]
    K --> L["Save admin"]
    L --> M["Existing JWT tokens become invalid"]
    M --> N["Admin logs in again"]
