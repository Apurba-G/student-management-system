# ==============================================================================
# Student Management System - Environment Variables Template
# Copy this file to .env and adjust your secrets before launching
# ==============================================================================

# PostgreSQL Database
POSTGRES_DB=sms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_PORT=5433

# pgAdmin GUI Dashboard
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@sms.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password

# JWT Security (Must be at least 256-bit / 32 characters in UTF-8)
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_key_at_least_32_characters
JWT_EXPIRATION=3600000

# Default Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_RECOVERY_KEY=your_emergency_recovery_key_here

# Port Mappings (Host ports)
BACKEND_PORT=8080
FRONTEND_PORT=4200
