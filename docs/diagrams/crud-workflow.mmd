
sequenceDiagram
    actor Admin
    participant UI as Angular
    participant SC as StudentController
    participant SS as StudentServiceImpl
    participant SM as StudentMapper
    participant SR as StudentRepository
    participant DB as PostgreSQL

    Admin->>UI: Submit student details
    UI->>SC: POST /api/v1/students
    SC->>SS: createStudent(request)
    SS->>SR: Check duplicate email and enrollment
    SR->>DB: Execute existence queries
    DB-->>SR: Query results

    alt Duplicate record exists
        SS-->>SC: Duplicate exception
        SC-->>UI: HTTP 409 Conflict
    else No duplicate
        SS->>SM: toEntity(request)
        SM-->>SS: Student entity
        SS->>SR: save(student)
        SR->>DB: INSERT student
        DB-->>SR: Saved record
        SR-->>SS: Saved entity
        SS->>SM: toResponse(entity)
        SM-->>SS: StudentResponse
        SS-->>SC: Response DTO
        SC-->>UI: HTTP 201 Created
    end
